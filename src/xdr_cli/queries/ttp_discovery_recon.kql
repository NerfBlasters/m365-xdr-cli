-- name: ttp_discovery_recon
-- description: AD / share enumeration — BloodHound, SharpHound, PowerView, net/nltest, LDAP-burst — correlated by device
-- tier: n
-- params: hours=24, device_name=, account_upn=, mode=summary
-- lists: KnownServiceAccounts, KnownRemoteSupportTools
-- agent_hint: Public list KnownRemoteSupportTools is wired as a -3 negative-weight
--   signal on the DeviceLeg LegScore (not a row-drop), per spec "Public-list
--   semantics" (line 239-247). An attacker-deployed RMM tool used for share
--   enumeration must still surface and can still reach medium via compounding
--   legs / multi-leg bonus. KnownServiceAccounts (lines 13 and 40) IS a row-drop
--   because it is a tenant-curated list per spec line 244.
let _xdr_KnownServiceAccounts = dynamic([]);
let _xdr_KnownRemoteSupportTools = dynamic([]);
let Window = {hours}h;
let DeviceLegCandidates = DeviceProcessEvents
    | where Timestamp > ago(Window)
    | where '{device_name}' == '' or DeviceName =~ '{device_name}'
    | where '{account_upn}' == '' or AccountUpn =~ '{account_upn}' or InitiatingProcessAccountUpn =~ '{account_upn}'
    | extend CmdLower = tolower(ProcessCommandLine)
    | extend Leg =
        case(
            CmdLower has "invoke-bloodhound" or CmdLower has "sharphound", "bloodhound",
            CmdLower has "crackmapexec" or CmdLower has "nxc ", "crackmapexec",
            CmdLower has "powerview", "powerview",
            CmdLower has "adexplorer", "adexplorer",
            CmdLower has "invoke-sharefinder" or CmdLower has "invoke-shareenum", "share-enum",
            CmdLower has "nltest" and CmdLower has "/domain_trusts", "nltest",
            CmdLower has "net" and CmdLower has "group" and CmdLower has "domain admins", "net-group",
            CmdLower has "ldapsearch", "ldapsearch",
            CmdLower has "dsquery", "dsquery",
            CmdLower has "get-domainuser" or CmdLower has "get-domaincomputer" or CmdLower has "get-domain", "get-domain",
            "")
    | where isnotempty(Leg)
    | extend IsRemoteSupportTool = InitiatingProcessFileName in (_xdr_KnownRemoteSupportTools)
    | extend LegScore = case(
        Leg in ("bloodhound","crackmapexec","powerview","adexplorer","share-enum"), 5,
        2)
        + iif(IsRemoteSupportTool, -3, 0)
    | project Timestamp, DeviceName,
              InitiatingProcessAccountName,
              AccountUpn = coalesce(AccountUpn, InitiatingProcessAccountUpn),
              Leg, LegScore, ProcessCommandLine, InitiatingProcessFileName,
              IsRemoteSupportTool,
              Source = "DeviceProcessEvents";
let DeviceLeg = DeviceLegCandidates
    | where not(InitiatingProcessAccountName in~ (_xdr_KnownServiceAccounts))
    | project-away InitiatingProcessAccountName;
let LdapCandidates = IdentityQueryEvents
    | where Timestamp > ago(Window)
    | where '{device_name}' == '' or DeviceName =~ '{device_name}'
    | where '{account_upn}' == '' or AccountUpn =~ '{account_upn}'
    | where not(AccountUpn endswith "$");
let LdapBurst = LdapCandidates
    | where not(AccountName in~ (_xdr_KnownServiceAccounts))
    | summarize QueryCount = count(), FirstSeen = min(Timestamp), LastSeen = max(Timestamp),
                AnyQuery = any(tostring(QueryTarget))
        by DeviceName, AccountUpn, bin(Timestamp, 5m)
    | where QueryCount > 5000
    | project Timestamp, DeviceName, AccountUpn,
              Leg = "ldap-burst",
              LegScore = 5,
              ProcessCommandLine = strcat("LDAP queries=", QueryCount, " sample=", AnyQuery),
              InitiatingProcessFileName = "",
              IsRemoteSupportTool = false,
              Source = "IdentityQueryEvents";
let SuppressedPerDeviceWindow = union
    (DeviceLegCandidates
        | where InitiatingProcessAccountName in~ (_xdr_KnownServiceAccounts)
        | extend WindowBin = bin(Timestamp, 3h)
        | project DeviceName, WindowBin),
    (LdapCandidates
        | where AccountName in~ (_xdr_KnownServiceAccounts)
        | extend WindowBin = bin(Timestamp, 3h)
        | project DeviceName, WindowBin)
    | summarize SuppressedCount = count() by DeviceName, WindowBin;
let Hits = union DeviceLeg, LdapBurst
    | extend WindowBin = bin(Timestamp, 3h);
let RankedDetail = Hits | order by LegScore desc, Timestamp desc;
let TopEv = RankedDetail
    | summarize TopEvidence = make_list(pack(
            "Timestamp", Timestamp,
            "Account",   AccountUpn,
            "Leg",       Leg,
            "Source",    Source,
            "Parent",    InitiatingProcessFileName,
            "CmdLine",   substring(ProcessCommandLine, 0, 400),
            "LegScore",  LegScore,
            "IsRemoteSupportTool", IsRemoteSupportTool
            ), 5)
        by DeviceName, WindowBin;
let Agg = Hits
    | summarize
        LegCount        = dcount(Leg),
        DistinctLegs    = make_set(Leg, 16),
        EventCount      = count(),
        EvidenceTotal   = count(),
        FirstSeen       = min(Timestamp),
        LastSeen        = max(Timestamp),
        MaxLegScore     = max(LegScore),
        SumLegScore     = sum(LegScore)
        by DeviceName, WindowBin
    | extend MultiLeg = LegCount >= 2
    | extend Score = MaxLegScore + (iff(MultiLeg, 5, 0))
    | extend Indicators = strcat("legs=", strcat_array(DistinctLegs, ","), iff(MultiLeg, " multi-leg", ""))
    | where Score >= 5;
let Correlated = Agg
    | join kind=leftouter TopEv on DeviceName, WindowBin
    | join kind=leftouter SuppressedPerDeviceWindow on DeviceName, WindowBin
    | extend SuppressedCount = coalesce(SuppressedCount, 0)
    | extend EvidenceOmitted = max_of(0, EvidenceTotal - array_length(TopEvidence))
    | extend ListHealth = _xdr_ListHealth
    | project DeviceName, WindowBin, Score, LegCount, DistinctLegs, EventCount,
              FirstSeen, LastSeen, Indicators, TopEvidence,
              EvidenceTotal, EvidenceOmitted, SuppressedCount, ListHealth
    | extend SchemaVersion = 1
    | extend Severity = case(Score >= 9, "critical", Score >= 6, "high", Score >= 3, "medium", Score >= 1, "low", "none");
let DetailRows = Hits
    | project Timestamp, DeviceName, AccountUpn, Leg, LegScore, Source,
              ParentFile = InitiatingProcessFileName, ProcessCommandLine,
              IsRemoteSupportTool;
union
    (Correlated | where '{mode}' == 'summary' | order by Score desc, LastSeen desc),
    (DetailRows | where '{mode}' == 'detail'  | order by Timestamp desc)
