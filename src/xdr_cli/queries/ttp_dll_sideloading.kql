-- name: ttp_dll_sideloading
-- description: DLL loaded from the same user-writable directory as the loading process — sideloading / hijack indicator with hijack-target awareness and signer suppression
-- tier: r2
-- params: hours=24, device_name=, account_upn=, mode=summary
-- lists: KnownGoodSigners
-- agent_hint: tables=[DeviceImageLoadEvents]; row_volume=high; cpu_class=medium; SHA1
--   5+ device baseline (KnownGoodDlls) is a hard-drop because tenant-curated counts
--   may suppress per spec. Public list `KnownGoodSigners` is wired as a
--   **negative-weight signal** (Score -3) per the spec's public-list-semantics
--   contract — a signed BYOVD driver or attacker-deployed legit-vendor binary must
--   still surface and can still reach medium severity via compounding signals.
let _xdr_KnownGoodSigners = dynamic([]);
let SuspiciousPaths = dynamic([
    "\\downloads\\", "\\temp\\", "\\tmp\\",
    "\\appdata\\local\\temp\\", "\\appdata\\roaming\\",
    "\\appdata\\local\\programs\\"
]);
// Common DLL sideloading / hijacking target names
let HijackableDllNames = dynamic([
    "version.dll", "winhttp.dll", "wininet.dll", "dbghelp.dll",
    "cryptsp.dll", "cryptbase.dll", "uxtheme.dll", "dwmapi.dll",
    "profapi.dll", "wldp.dll", "amsi.dll", "ntmarta.dll",
    "sechost.dll", "propsys.dll", "wintrust.dll", "userenv.dll",
    "msasn1.dll", "sspicli.dll", "vcruntime140.dll", "msvcp140.dll",
    "vcruntime140_1.dll", "wbemprox.dll", "wbemcomn.dll"
]);
// Suppress DLL SHA1s seen on 5+ devices — known-good bundled DLLs in common software
let KnownGoodDlls = DeviceImageLoadEvents
| where Timestamp > ago({hours}h)
| where FolderPath has_any (SuspiciousPaths)
| where isnotempty(SHA1)
| summarize DeviceCount=dcount(DeviceId) by SHA1
| where DeviceCount >= 5;
let CandidateRows = DeviceImageLoadEvents
| where Timestamp > ago({hours}h)
| where FolderPath has_any (SuspiciousPaths)
| where FileName endswith ".dll"
| where '{device_name}' == '' or DeviceName has '{device_name}'
| where '{account_upn}' == '' or InitiatingProcessAccountUpn =~ '{account_upn}'
// Extract directory portion from both full file paths (strip filename)
| extend DllDir  = extract(@"^(.*\\)[^\\]+$", 1, FolderPath)
| extend ProcDir = extract(@"^(.*\\)[^\\]+$", 1, InitiatingProcessFolderPath)
// DLL and the process that loaded it are in the same directory — sideloading pattern
| where DllDir =~ ProcDir;
let SuppressedPerDevice = CandidateRows
    | join kind=leftsemi KnownGoodDlls on SHA1
    | summarize SuppressedCount = count() by DeviceName;
let ScoredEvents = CandidateRows
| join kind=leftanti KnownGoodDlls on SHA1
// KnownGoodSigners is a NEGATIVE-WEIGHT signal, not a row-drop filter — see spec
// "Public-list semantics" (~line 239). A signed BYOVD / partner-vendor DLL must
// still surface in detail mode and can still reach medium via compounding signals.
| extend
    IsHijackTarget      = FileName in~ (HijackableDllNames),
    // Loading process has no vendor name — unsigned/unrecognized binary
    LoaderUnknownVendor = isempty(InitiatingProcessVersionInfoCompanyName),
    // Signed Microsoft binary loading a DLL from a user-writable path — injection into legit process
    LoaderIsMicrosoft   = InitiatingProcessVersionInfoCompanyName has "Microsoft",
    // Public-list signed vendor — negative-weight signal, not a hard-drop
    IsKnownGoodSigner   = InitiatingProcessVersionInfoCompanyName in (_xdr_KnownGoodSigners)
| extend Score =
    (iif(IsHijackTarget, 4, 0)) +
    (iif(LoaderUnknownVendor, 2, 0)) +
    (iif(LoaderIsMicrosoft, 3, 0)) +
    (iif(IsKnownGoodSigner, -3, 0))
| extend Indicators = trim(" ", strcat(
    iif(IsHijackTarget, "known-hijack-target ", ""),
    iif(LoaderUnknownVendor, "unknown-vendor-loader ", ""),
    iif(LoaderIsMicrosoft, "ms-binary-sideloading ", ""),
    iif(IsKnownGoodSigner, "signed-vendor ", "")
    ));
let SummaryRow = ScoredEvents
    | order by Score desc
    | summarize
        Score                        = max(Score),
        SideloadCount                = count(),
        EvidenceTotal                = count(),
        FirstSeen                    = min(Timestamp),
        LastSeen                     = max(Timestamp),
        MaxScore                     = max(Score),
        IsHijackTargetCount          = countif(IsHijackTarget),
        UnknownVendorLoaderCount     = countif(LoaderUnknownVendor),
        MicrosoftBinarySideloadCount = countif(LoaderIsMicrosoft),
        TopEvidence = make_list(pack(
            'Timestamp',      Timestamp,
            'Device',         DeviceName,
            'DllFileName',    FileName,
            'DllDir',         FolderPath,
            'LoadingProcess', InitiatingProcessFileName,
            'LoaderVendor',   InitiatingProcessVersionInfoCompanyName,
            'Score',          Score), 5)
        by DeviceName
    | join kind=leftouter SuppressedPerDevice on DeviceName
    | extend SuppressedCount = coalesce(SuppressedCount, 0)
    | extend EvidenceOmitted = max_of(0, EvidenceTotal - array_length(TopEvidence))
    | extend ListHealth = _xdr_ListHealth
    | extend SchemaVersion = 1
    | extend Severity = case(Score >= 7, 'critical', Score >= 5, 'high', Score >= 3, 'medium', 'low');
let DetailRows = ScoredEvents
    | project Timestamp, DeviceName, FileName, FolderPath,
              InitiatingProcessFileName, InitiatingProcessVersionInfoCompanyName,
              IsHijackTarget, LoaderUnknownVendor, LoaderIsMicrosoft,
              IsKnownGoodSigner, Score;
union
    (SummaryRow | where '{mode}' == 'summary' | order by Score desc),
    (DetailRows | where '{mode}' == 'detail'  | order by Timestamp desc)
