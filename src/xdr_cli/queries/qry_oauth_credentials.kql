-- name: qry_oauth_credentials
-- description: Credential additions (secrets, certificates) to an OAuth app — persistence mechanism detection
-- tier: pivot
-- params: app_id, start, end, mode=detail
// CloudAppEvents (not GraphAPIAuditEvents) carries the Office 365 audit-log
// records for credential additions to service principals / app registrations.
// GraphAPIAuditEvents has no ActionType / AccountUpn columns. ActorUpn is
// resolved from RawEventData.UserId (CloudAppEvents has no AccountUpn).
let DetailRows =
    CloudAppEvents
    | where Timestamp between(datetime({start}) .. datetime({end}))
    | where ActionType has_any ('Add service principal credentials',
                                'Update application – Certificates and secrets management',
                                'Update application')
    | where RawEventData has '{app_id}'
    | extend ActorUpn = tostring(RawEventData.UserId)
    | project Timestamp, AccountObjectId, ActorUpn, ActionType, IPAddress;
let SummaryRow =
    DetailRows
    | summarize
        CredAddCount   = count(),
        DistinctActors = dcount(ActorUpn)
    | extend SchemaVersion = 1;
union
    (SummaryRow | where '{mode}' == 'summary'),
    (DetailRows | where '{mode}' == 'detail' | order by Timestamp asc)
