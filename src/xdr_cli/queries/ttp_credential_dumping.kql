-- name: ttp_credential_dumping
-- description: T1003 LSASS credential dumping — comsvcs.dll MiniDump, procdump -ma lsass, rundll32 MiniDumpW, mimikatz / sekurlsa / lsadump cmdline literals, nanodump / dumpert / pypykatz / SilentTrinity, taskmgr -d, sqldumper LOLBin, plus DeviceEvents OpenProcess/ReadProcessMemory against lsass.exe with signer-allowlist and KnownGoodSigners suppression
-- tier: n
-- params: hours=24, device_id=, account_upn=, mode=summary
-- lists: KnownGoodSigners, KnownServiceAccounts
-- agent_hint: tables=[DeviceProcessEvents,DeviceEvents]; row_volume=medium; cpu_class=medium.
--   DeviceEvents ActionType values are "OpenProcessApiCall" and "ReadProcessMemoryApiCall"
--   per Microsoft's MDE schema; FileName on those rows is the *target* (lsass.exe) and
--   InitiatingProcessFileName is the *dumper*. KnownGoodSigners / KnownServiceAccounts are
--   suppression lists (empty -> admits all rows; `!in`/`in~` direction chosen to fail open).
let _xdr_KnownGoodSigners      = dynamic([]);
let _xdr_KnownServiceAccounts  = dynamic([]);
let Window = {hours}h;
let ComsvcsRegex   = @"(?i)comsvcs\.dll[^,]*?,\s*minidump";
let ProcdumpRegex  = @"(?i)\bprocdump(64)?(\.exe)?\b[\s\S]*?\-ma\b[\s\S]*?lsass";
let Rundll32Mini   = @"(?i)\brundll32(\.exe)?\b[\s\S]*?(minidumpw|minidumpwritedump)";
let MimikatzRegex  = @"(?i)(mimikatz|sekurlsa::|lsadump::|kerberos::|privilege::debug)";
let NanoDumpRegex  = @"(?i)(nanodump|dumpert|pypykatz|silenttrinity|nppspy|hekatomb|safetykatz|outflank-dumpert)";
let TaskmgrRegex   = @"(?i)\btaskmgr(\.exe)?\b[\s\S]*?(\s\-d\b|/d\b)";
let SqldumperRegex = @"(?i)\bsqldumper(\.exe)?\b[\s\S]*?(0x01100|lsass|mdmp)";
// ---- Process-cmdline leg ----
let CmdLeg = DeviceProcessEvents
    | where Timestamp > ago(Window)
    | where ActionType == "ProcessCreated"
    | where '{device_id}'   == '' or DeviceId =~ '{device_id}' or DeviceName =~ '{device_id}'
    | where '{account_upn}' == '' or AccountUpn =~ '{account_upn}' or AccountName =~ '{account_upn}'
    | extend Cmd = coalesce(ProcessCommandLine, "")
    | extend ParentCmd = coalesce(InitiatingProcessCommandLine, "")
    | where Cmd matches regex ComsvcsRegex
         or Cmd matches regex ProcdumpRegex
         or Cmd matches regex Rundll32Mini
         or Cmd matches regex MimikatzRegex
         or Cmd matches regex NanoDumpRegex
         or Cmd matches regex TaskmgrRegex
         or Cmd matches regex SqldumperRegex
         or ParentCmd matches regex MimikatzRegex
    | extend
        IsComsvcs   = Cmd matches regex ComsvcsRegex,
        IsProcdump  = Cmd matches regex ProcdumpRegex,
        IsRundll32  = Cmd matches regex Rundll32Mini,
        IsMimikatz  = (Cmd matches regex MimikatzRegex) or (ParentCmd matches regex MimikatzRegex),
        IsNanoDump  = Cmd matches regex NanoDumpRegex,
        IsTaskmgr   = Cmd matches regex TaskmgrRegex,
        IsSqldumper = Cmd matches regex SqldumperRegex
    | extend
        Leg          = "cmdline",
        Initiator    = FileName,
        InitiatorSigner = tostring(InitiatingProcessVersionInfoCompanyName),
        InitiatorSignerType = "",
        Target       = "lsass.exe",
        IsLsassOpen  = false,
        EvidenceLine = substring(Cmd, 0, 400);
// ---- DeviceEvents OpenProcess / ReadProcessMemory leg ----
let ApiLeg = DeviceEvents
    | where Timestamp > ago(Window)
    | where ActionType in ("OpenProcessApiCall", "ReadProcessMemoryApiCall")
    | where FileName =~ "lsass.exe"
    | where '{device_id}'   == '' or DeviceId =~ '{device_id}' or DeviceName =~ '{device_id}'
    | where '{account_upn}' == '' or InitiatingProcessAccountUpn =~ '{account_upn}'
                                  or InitiatingProcessAccountName =~ '{account_upn}'
    | extend
        Leg               = "api",
        Initiator         = InitiatingProcessFileName,
        InitiatorSigner   = tostring(InitiatingProcessVersionInfoCompanyName),
        InitiatorSignerType = "",
        Target            = FileName,
        Cmd               = coalesce(InitiatingProcessCommandLine, ""),
        ParentCmd         = "",
        IsComsvcs   = false,
        IsProcdump  = false,
        IsRundll32  = false,
        IsMimikatz  = false,
        IsNanoDump  = false,
        IsTaskmgr   = false,
        IsSqldumper = false,
        IsLsassOpen = true,
        EvidenceLine = strcat(InitiatingProcessFileName, " -> ", FileName, " [", ActionType, "]");
let Unioned = union
    (CmdLeg | project Timestamp, DeviceId, DeviceName, AccountName, AccountUpn,
                       Initiator, InitiatorSigner, Target,
                       Cmd, ParentCmd, EvidenceLine, Leg,
                       IsComsvcs, IsProcdump, IsRundll32, IsMimikatz, IsNanoDump,
                       IsTaskmgr, IsSqldumper, IsLsassOpen),
    (ApiLeg | project Timestamp, DeviceId, DeviceName,
                       AccountName = InitiatingProcessAccountName,
                       AccountUpn  = InitiatingProcessAccountUpn,
                       Initiator, InitiatorSigner, Target,
                       Cmd, ParentCmd, EvidenceLine, Leg,
                       IsComsvcs, IsProcdump, IsRundll32, IsMimikatz, IsNanoDump,
                       IsTaskmgr, IsSqldumper, IsLsassOpen);
let Scored = Unioned
    | extend
        IsKnownGoodSigner = isnotempty(InitiatorSigner)
                            and InitiatorSigner in~ (_xdr_KnownGoodSigners),
        IsUnsignedParent  = isempty(InitiatorSigner),
        IsKnownService    = isnotempty(AccountName)
                            and AccountName in~ (_xdr_KnownServiceAccounts),
        // Allowlisted EDR/AV reading LSASS without any cmdline hit -> high suppression.
        IsBenignApiOnly   = Leg == "api"
                            and isnotempty(InitiatorSigner)
                            and InitiatorSigner in~ (_xdr_KnownGoodSigners)
                            and not(Cmd matches regex MimikatzRegex)
                            and not(Cmd matches regex ProcdumpRegex)
                            and not(Cmd matches regex Rundll32Mini)
                            and not(Cmd matches regex NanoDumpRegex)
    | extend Score =
          (iff(IsComsvcs,                                6, 0))
        + (iff(IsProcdump,                               6, 0))
        + (iff(IsRundll32,                               6, 0))
        + (iff(IsMimikatz,                               6, 0))
        + (iff(IsNanoDump,                               5, 0))
        + (iff(IsLsassOpen and not(IsKnownGoodSigner),   5, 0))
        + (iff(IsTaskmgr,                                4, 0))
        + (iff(IsSqldumper,                              4, 0))
        + (iff(IsUnsignedParent,                         2, 0))
        - (iff(IsKnownService,                           3, 0))
        - (iff(IsBenignApiOnly,                          4, 0))
    | where Score > 0
    | extend Indicators = strcat_array(pack_array(
            iff(IsComsvcs,           "comsvcs-minidump",  ""),
            iff(IsProcdump,          "procdump-lsass",    ""),
            iff(IsRundll32,          "rundll32-minidump", ""),
            iff(IsMimikatz,          "mimikatz-cmdline",  ""),
            iff(IsNanoDump,          "nanodump-family",   ""),
            iff(IsLsassOpen,         "lsass-openprocess", ""),
            iff(IsTaskmgr,           "taskmgr-dump",      ""),
            iff(IsSqldumper,         "sqldumper-lolbin",  ""),
            iff(IsUnsignedParent,    "unsigned-parent",   ""),
            iff(IsKnownGoodSigner,   "known-good-signer", "")
        ), " ");
let RankedDetail = Scored | order by Score desc, Timestamp desc;
let TopEv = RankedDetail
    | summarize TopEvidence = make_list(pack(
            "Timestamp",  Timestamp,
            "DeviceName", DeviceName,
            "AccountName",AccountName,
            "Initiator",  Initiator,
            "Target",     Target,
            "Evidence",   EvidenceLine,
            "Score",      Score), 5)
        by DeviceName;
let Agg = Scored
    | summarize
        Score              = max(Score),
        DumpEventCount     = count(),
        EvidenceTotal      = count(),
        ComsvcsCount       = countif(IsComsvcs),
        ProcdumpCount      = countif(IsProcdump),
        Rundll32Count      = countif(IsRundll32),
        MimikatzCount      = countif(IsMimikatz),
        NanoDumpCount      = countif(IsNanoDump),
        LsassOpenCount     = countif(IsLsassOpen),
        TaskmgrCount       = countif(IsTaskmgr),
        SqldumperCount     = countif(IsSqldumper),
        UnsignedParentHits = countif(IsUnsignedParent),
        KnownGoodHits      = countif(IsKnownGoodSigner),
        Initiators         = make_set(Initiator, 8),
        Accounts           = make_set(AccountName, 8),
        FirstSeen          = min(Timestamp),
        LastSeen           = max(Timestamp),
        Indicators         = strcat_array(make_set(Indicators, 8), " ")
        by DeviceName, DeviceId;
let SummaryRow = Agg
    | join kind=leftouter TopEv on DeviceName
    // SuppressedCount = 0: KSA / KnownGoodSigners are wired as negative-weight annotations, not row-drops.
    | extend SuppressedCount = 0
    | extend EvidenceOmitted = max_of(0, EvidenceTotal - array_length(TopEvidence))
    | extend ListHealth = _xdr_ListHealth
    | project DeviceName, DeviceId, Score, DumpEventCount,
              ComsvcsCount, ProcdumpCount, Rundll32Count, MimikatzCount, NanoDumpCount,
              LsassOpenCount, TaskmgrCount, SqldumperCount,
              UnsignedParentHits, KnownGoodHits,
              Initiators, Accounts, FirstSeen, LastSeen, Indicators, TopEvidence,
              EvidenceTotal, EvidenceOmitted, SuppressedCount, ListHealth
    | extend SchemaVersion = 1
    | extend Severity = case(Score >= 9, "critical", Score >= 6, "high", Score >= 3, "medium", Score >= 1, "low", "none");
let DetailRows = Scored
    | project Timestamp, DeviceName, DeviceId, AccountName, AccountUpn,
              Leg, Initiator, InitiatorSigner, Target, EvidenceLine, Cmd, ParentCmd,
              IsComsvcs, IsProcdump, IsRundll32, IsMimikatz, IsNanoDump,
              IsLsassOpen, IsTaskmgr, IsSqldumper, IsUnsignedParent, IsKnownGoodSigner,
              Score;
union
    (SummaryRow | where '{mode}' == 'summary' | order by Score desc),
    (DetailRows | where '{mode}' == 'detail'  | order by Score desc, Timestamp desc)
