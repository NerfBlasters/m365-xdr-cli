-- name: qry_app_data_access
-- description: File downloads, access, and uploads by an OAuth app — data exfiltration detection
-- tier: pivot
-- params: app_name, start, end, mode=detail
let DetailRows =
    CloudAppEvents
    | where Timestamp between(datetime({start}) .. datetime({end}))
    | where Application contains '{app_name}'
    | where ActionType in ('FileDownloaded', 'FileAccessed', 'FileUploaded', 'FileSyncDownloadedFull')
    // UserId is source-provided; it is not necessarily a normalized UPN.
    | extend AccountUpn = tostring(parse_json(RawEventData).UserId)
    | project Timestamp, AccountUpn, ActionType, ObjectName, ObjectType, IPAddress, UserAgent;
let SummaryRow =
    DetailRows
    | summarize
        EventCount         = count(),
        DistinctAccounts   = dcountif(AccountUpn, isnotempty(AccountUpn)),
        DistinctActions    = make_set(ActionType),
        DistinctObjects    = dcount(ObjectName),
        FirstSeen          = min(Timestamp),
        LastSeen           = max(Timestamp)
    | extend SchemaVersion = 1
    | extend Application = '{app_name}';
union
    (SummaryRow | where '{mode}' == 'summary'),
    (DetailRows | where '{mode}' == 'detail' | order by Timestamp desc)
