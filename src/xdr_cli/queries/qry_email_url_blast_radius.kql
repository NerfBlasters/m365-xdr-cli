-- name: qry_email_url_blast_radius
-- description: Recipients who received email containing a specific URL or domain — scopes phishing campaign reach
-- tier: pivot
-- params: url_domain, start, end, mode=detail
let MatchedRows =
    EmailUrlInfo
    | where Timestamp between(datetime({start}) .. datetime({end}))
    | where Url has '{url_domain}' or UrlDomain == '{url_domain}'
    | project Timestamp, NetworkMessageId, Url, UrlDomain
    | join kind=inner (
        EmailEvents
        | where Timestamp between(datetime({start}) .. datetime({end}))
        // One recipient mapping per message; repeated delivery records must not
        // multiply the URL rows. This measures delivery scope, not URL clicks.
        | summarize by NetworkMessageId, RecipientEmailAddress
    ) on NetworkMessageId;
let DetailRows =
    MatchedRows
    | summarize Recipients=make_set(RecipientEmailAddress), MessageUrlRows=count() by UrlDomain;
let SummaryRow =
    MatchedRows
    | summarize
        RecipientCount   = dcount(RecipientEmailAddress),
        DistinctUrls     = dcount(Url),
        DistinctMessages = dcount(NetworkMessageId)
    | extend SchemaVersion = 1;
union
    (SummaryRow | where '{mode}' == 'summary'),
    (DetailRows | where '{mode}' == 'detail')
