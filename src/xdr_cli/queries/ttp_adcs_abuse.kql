-- name: ttp_adcs_abuse
-- description: (beta) ADCS abuse signals — template enrollment by non-admin, SAN/requester mismatch, ESC8 NTLM-relay artefacts
-- tier: beta
-- params: hours=72, account_upn=, mode=summary
-- lists: KnownServiceAccounts
let _xdr_KnownServiceAccounts = dynamic([]);
let Window = {hours}h;
let TemplateCandidates = IdentityDirectoryEvents
    | where Timestamp > ago(Window)
    | where ActionType has_any ("Certificate", "Template", "Enrollment", "PKI")
    | where '{account_upn}' == '' or AccountUpn =~ '{account_upn}'
    | extend Detail = strcat(ActionType, " | ", tostring(AdditionalFields))
    | extend SanMismatch = Detail has "SubjectAltName" and Detail has_any ("mismatch", "differs", "override")
    | extend Esc1Indicator = Detail has_any ("EnrolleeSuppliesSubject", "ENROLLEE_SUPPLIES_SUBJECT")
    | project Timestamp, AccountUpn, AccountName, DeviceName, ActionType, Detail,
              SanMismatch, Esc1Indicator, Leg = "template-enroll";
let TemplateLeg = TemplateCandidates
    | where not(AccountName in~ (_xdr_KnownServiceAccounts));
let TemplateSuppressed = TemplateCandidates
    | where AccountName in~ (_xdr_KnownServiceAccounts)
    | summarize SuppressedCount = count() by AccountUpn;
let Esc8Leg = DeviceNetworkEvents
    | where Timestamp > ago(Window)
    | where RemoteUrl has_any ("/certsrv/", "/certenroll/", "ADPolicyProvider_CEP", "ADPolicyProvider_CES")
    | where RemotePort in (80, 8080)
    | where '{account_upn}' == '' or InitiatingProcessAccountUpn =~ '{account_upn}'
    | project Timestamp, AccountUpn = InitiatingProcessAccountUpn,
              AccountName = InitiatingProcessAccountName,
              DeviceName, ActionType, Detail = strcat("HTTP-ADCS ", RemoteUrl, " :", RemotePort),
              SanMismatch = false, Esc1Indicator = false,
              Leg = "esc8-http";
let Hits = union TemplateLeg, Esc8Leg;
let Scored = Hits
    | extend LegScore = case(
        Esc1Indicator, 6,
        SanMismatch,   5,
        Leg == "esc8-http", 4,
        2);
let RankedDetail = Scored | order by LegScore desc, Timestamp desc;
let TopEv = RankedDetail
    | summarize TopEvidence = make_list(pack(
            "Timestamp",   Timestamp,
            "Account",     AccountUpn,
            "Device",      DeviceName,
            "Leg",         Leg,
            "ActionType",  ActionType,
            "Detail",      substring(Detail, 0, 400),
            "LegScore",    LegScore
            ), 5)
        by AccountUpn;
let Agg = Scored
    | summarize
        Score          = sum(LegScore),
        EventCount     = count(),
        EvidenceTotal  = count(),
        DistinctLegs   = make_set(Leg, 8),
        FirstSeen      = min(Timestamp),
        LastSeen       = max(Timestamp),
        AnySanMismatch = max(toint(SanMismatch)),
        AnyEsc1        = max(toint(Esc1Indicator))
        by AccountUpn
    | extend Score = min_of(Score, 12)
    | extend Indicators = strcat_array(DistinctLegs, " ")
    | where Score >= 3;
let Correlated = Agg
    | join kind=leftouter TopEv on AccountUpn
    | join kind=leftouter TemplateSuppressed on AccountUpn
    | extend SuppressedCount = coalesce(SuppressedCount, 0)
    | extend EvidenceOmitted = max_of(0, EvidenceTotal - array_length(TopEvidence))
    | extend ListHealth = _xdr_ListHealth
    | project AccountUpn, Score, EventCount, DistinctLegs, FirstSeen, LastSeen,
              AnySanMismatch, AnyEsc1, Indicators, TopEvidence,
              EvidenceTotal, EvidenceOmitted, SuppressedCount, ListHealth
    | extend SchemaVersion = 1
    | extend Severity = case(Score >= 9, "critical", Score >= 6, "high", Score >= 3, "medium", Score >= 1, "low", "none");
let DetailRows = Scored
    | project Timestamp, AccountUpn, AccountName, DeviceName, Leg, LegScore, ActionType, Detail;
union
    (Correlated | where '{mode}' == 'summary' | order by Score desc),
    (DetailRows | where '{mode}' == 'detail'  | order by Timestamp desc)
