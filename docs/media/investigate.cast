[15.965271, "o", "{\"status\":\"success\",\"schema_version\":1,\"run_id\":\"20261004T015320208541Z-6d8530c9b3c5\",\"data_path\":\"/home/demo/.xdr-cli/results/2026-10-04/20261004T015320208541Z-6d8530c9b3c5.jsonl\",\"meta_path\":\"/home/demo/.xdr-cli/results/2026-10-04/20261004T015320208541Z-6d8530c9b3c5.meta.json\",\"rows\":61,\"server_truncation_state\":\"unknown\",\"execution_time_ms\":6618,\"session_id\":\"demo-1\",\"session_label\":\"incident-2\",\"session_attachment\":\"single-active\",\"incident_id\":\"2\",\"alert_id\":null,\"context\":{\"shown\":2,\"total\":61,\"has_more\":true,\"results_command\":\"xdr results rows 20261004T015320208541Z-6d8530c9b3c5 --offset 0 --limit 100\",\"next_command\":\"xdr results rows 20261004T015320208541Z-6d8530c9b3c5 --offset 0 --limit 100\"}}\r\n{\"@odata.context\":\"https://graph.microsoft.com/v1.0/$metadata#security/incidents(alerts())/$entity\",\"id\":\"2\",\"tenantId\":\"00000000-0000-0000-0000-000000000002\",\"status\":\"active\",\"incidentWebUrl\":\"https://security.microsoft.com/incident2/2/overview?tid=00000000-0000-0000-0000-000000000002\",\"redirectIncidentId\":null,\"displayName\":\"Multi-stage incident involving Credential access & Lateral movement on multiple endpoints\",\"createdDateTime\":\"2026-09-30T22:59:16.03Z\",\"lastUpdateDateTime\":\"2026-10-01T00:06:26.2966667Z\",\"assignedTo\":null,\"classification\":\"unknown\",\"determination\":\"unknown\",\"severity\":\"high\",\"customTags\":[],\"systemTags\":[],\"description\":\"One or more suspicious Kerberoasting-related Lightweight Directory Access Protocol (LDAP) discovery activities originating from the IP address 192.0.2.254 have been detected. This activity might indicate a potential Kerberoasting attack, where an attacker enumerates accounts with Service Principal Names (that is, Kerberoastable accounts) in Active Directory and then requests Kerberos service tickets for these accounts. The attacker then extracts and attempts to crack the encrypted tickets offline to obtain the plaintext passwords of those accounts. These targeted accounts might have been compromised, allowing the attacker to move laterally within the organization, escalate privileges, steal data, or set up backdoors for future access and persistence. Investigate immediately to mitigate the associated security risks.\",\"lastModifiedBy\":\"Microsoft 365 Defender-AlertCorrelation\",\"resolvingComment\":null,\"summary\":null,\"priorityScore\":100,\"comments\":[],\"parent_incident_id\":\"2\",\"record_type\":\"incident\"}\r\n{\"id\":\"aa00000000-0000-0000-0000-000000000001\",\"providerAlertId\":\"00000000-0000-0000-0000-000000000001\",\"incidentId\":\"2\",\"status\":\"new\",\"severity\":\"high\",\"classification\":null,\"determination\":null,\"serviceSource\":\"microsoftDefenderForIdentity\",\"detectionSource\":\"microsoftDefenderForIdentity\",\"productName\":\"Microsoft Defender for Identity\",\"detectorId\":\"DirectoryServicesReplicationSecurityAlert\",\"tenantId\":\"00000000-0000-0000-0000-000000000002\",\"title\":\"Suspected DCSync attack (replication of directory services)\",\"description\":\"Cersei Lanister on 192.0.2.254 (192.0.2.254) sent 2 replication requests to KINGSLANDING.\",\"recommendedActions\":\"\",\"category\":\"CredentialAccess\",\"categories\":[\"CredentialAccess\"],\"assignedTo\":null,\"alertWebUrl\":\"https://security.microsoft.com/alerts/aa00000000-0000-0000-0000-000000000001?tid=00000000-0000-0000-0000-000000000002\",\"incidentWebUrl\":\"https://security.microsoft.com/incident2/2/overview?tid=00000000-0000-0000-0000-000000000002\",\"actorDisplayName\":null,\"threatDisplayName\":null,\"threatFamilyName\":null,\"mitreTechniques\":[\"T1003\",\"T1003.006\"],\"createdDateTime\":\"2026-09-30T23:01:50.7033333Z\",\"lastUpdateDateTime\":\"2026-09-30T23:05:48.0566667Z\",\"resolvedDateTime\":null,\"firstActivityDateTime\":\"2026-09-30T22:57:25.903712Z\",\"lastActivityDateTime\":\"2026-09-30T23:01:55.207617Z\",\"systemTags\":[],\"alertPolicyId\":null,\"investigationState\":\"unsupportedAlertType\",\"comments\":[],\"customDetails\":{},\"additionalData\":{},\"parent_incident_id\":\"2\",\"parent_alert_id\":\"aa00000000-0000-0000-0000-000000000001\",\"record_type\":\"alert\"}\r\n"]
