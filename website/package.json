{
  "name": "xdr-cli-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "npm run content && astro dev --host 127.0.0.1",
    "check": "npm run content && astro check",
    "build": "npm run content && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "social": "node scripts/render-social.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/markdown-remark": "^7.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "cheerio": "^1.1.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
